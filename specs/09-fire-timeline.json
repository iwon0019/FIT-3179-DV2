{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "09 fire timeline",
  "width": "container",
  "height": 280,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "domain": false,
      "tickColor": "#e3e7e1",
      "gridColor": "#e3e7e1",
      "labelLimit": 130
    },
    "legend": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "titleFontSize": 11,
      "labelFontSize": 11,
      "orient": "bottom",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#287566",
        "#b86038",
        "#527da2",
        "#967544",
        "#796899",
        "#579189",
        "#9e5572",
        "#657940"
      ]
    },
    "title": {
      "color": "#203c30"
    }
  },
  "data": {
    "url": "data/site/fire-daily.json"
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2025
    }
  ],
  "transform": [
    {
      "filter": "datum.year == selectedYear"
    }
  ],
  "layer": [
    {
      "name": "hotspot_bars",
      "mark": {
        "type": "bar",
        "color": "#b86038"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%b",
            "tickCount": 12
          }
        },
        "y": {
          "field": "detections",
          "type": "quantitative",
          "title": "Detections / day",
          "scale": {
            "domain": [
              0,
              240
            ]
          }
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Date",
            "format": "%d %b %Y"
          },
          {
            "field": "detections",
            "type": "quantitative",
            "title": "Hotspot detections",
            "format": ",d"
          }
        ]
      },
      "params": [
        {
          "name": "episode",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ]
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "date": "2024-04-07",
            "year": 2024,
            "detections": 178,
            "label": [
              "07 Apr: 178 detections",
              "April: local smoke reported."
            ]
          },
          {
            "date": "2025-07-28",
            "year": 2025,
            "detections": 182,
            "label": [
              "28 Jul: 182 detections",
              "July: dry weather favoured",
              "regional fire activity."
            ]
          }
        ]
      },
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#b86038",
        "size": 50
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "detections",
          "type": "quantitative"
        }
      },
      "transform": [
        {
          "filter": "datum.year == selectedYear"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "date": "2024-04-07",
            "year": 2024,
            "detections": 178,
            "label": [
              "07 Apr: 178 detections",
              "April: local smoke reported."
            ]
          },
          {
            "date": "2025-07-28",
            "year": 2025,
            "detections": 182,
            "label": [
              "28 Jul: 182 detections",
              "July: dry weather favoured",
              "regional fire activity."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": {
          "expr": "selectedYear == 2025 ? 'right' : 'left'"
        },
        "dx": {
          "expr": "selectedYear == 2025 ? -9 : 9"
        },
        "dy": -40,
        "fontSize": 11,
        "lineHeight": 13,
        "color": "#b86038"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "detections",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      },
      "transform": [
        {
          "filter": "datum.year == selectedYear"
        }
      ]
    }
  ]
}