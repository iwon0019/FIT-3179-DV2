{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "12 bin map",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "domain": false,
      "tickColor": "#e3e7e1",
      "gridColor": "#e3e7e1",
      "labelLimit": 130
    },
    "legend": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "titleFontSize": 11,
      "labelFontSize": 11,
      "orient": "bottom",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#287566",
        "#b86038",
        "#527da2",
        "#967544",
        "#796899",
        "#579189",
        "#9e5572",
        "#657940"
      ]
    },
    "title": {
      "color": "#203c30"
    }
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2025
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/site/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e4ebe1",
        "stroke": "#a2b5a6",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "data/site/fire-bins.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.year == selectedYear"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 0.25
      },
      "encoding": {
        "color": {
          "field": "properties.detections",
          "type": "quantitative",
          "title": "Detections / cell",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              361
            ],
            "range": [
              "#f4dec3",
              "#a24925"
            ]
          }
        },
        "tooltip": [
          {
            "field": "properties.year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "properties.detections",
            "type": "quantitative",
            "title": "Detections in cell",
            "format": ",d"
          }
        ]
      }
    }
  ]
}