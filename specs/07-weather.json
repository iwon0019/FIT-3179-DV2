{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "07 weather",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "domain": false,
      "tickColor": "#e3e7e1",
      "gridColor": "#e3e7e1",
      "labelLimit": 130
    },
    "legend": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "titleFontSize": 11,
      "labelFontSize": 11,
      "orient": "bottom",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#287566",
        "#b86038",
        "#527da2",
        "#967544",
        "#796899",
        "#579189",
        "#9e5572",
        "#657940"
      ]
    },
    "title": {
      "color": "#203c30"
    }
  },
  "data": {
    "url": "data/site/daily.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "pm25": "number",
        "rain": "number",
        "temperature": "number",
        "wind": "number",
        "has_weather": "boolean",
        "jitter": "number"
      }
    }
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2025
    },
    {
      "name": "selectedCity",
      "value": "L00"
    }
  ],
  "transform": [
    {
      "filter": "datum.year == selectedYear"
    },
    {
      "filter": "datum.location_key == selectedCity"
    },
    {
      "filter": "datum.has_weather"
    }
  ],
  "mark": {
    "type": "circle",
    "size": 42,
    "opacity": 0.5,
    "color": "#527da2"
  },
  "encoding": {
    "x": {
      "field": "rain",
      "type": "quantitative",
      "title": "Daily precipitation (mm)",
      "scale": {
        "zero": true
      }
    },
    "y": {
      "field": "pm25",
      "type": "quantitative",
      "title": "Daily PM2.5 (µg/m³)",
      "scale": {
        "domain": [
          0,
          140
        ]
      }
    },
    "tooltip": [
      {
        "field": "city",
        "type": "nominal",
        "title": "Location"
      },
      {
        "field": "date",
        "type": "temporal",
        "title": "Date",
        "format": "%d %b %Y"
      },
      {
        "field": "pm25",
        "type": "quantitative",
        "title": "PM2.5 (µg/m³)",
        "format": ".1f"
      },
      {
        "field": "rain",
        "type": "quantitative",
        "title": "Precipitation (mm)",
        "format": ".1f"
      },
      {
        "field": "wind",
        "type": "quantitative",
        "title": "10 m wind (km/h)",
        "format": ".1f"
      }
    ]
  }
}