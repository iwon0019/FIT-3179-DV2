{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "02 residence",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "domain": false,
      "tickColor": "#e3e7e1",
      "gridColor": "#e3e7e1",
      "labelLimit": 130
    },
    "legend": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "titleFontSize": 11,
      "labelFontSize": 11,
      "orient": "bottom",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#287566",
        "#b86038",
        "#527da2",
        "#967544",
        "#796899",
        "#579189",
        "#9e5572",
        "#657940"
      ]
    },
    "title": {
      "color": "#203c30"
    }
  },
  "data": {
    "url": "data/site/who.json"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 2,
    "cornerRadiusTopRight": 2
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0
      }
    },
    "xOffset": {
      "field": "residence_type"
    },
    "y": {
      "field": "pm25_ugm3",
      "type": "quantitative",
      "title": "Annual PM2.5 (µg/m³)"
    },
    "color": {
      "field": "residence_type",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Urban",
          "Rural"
        ],
        "range": [
          "#287566",
          "#b2c7a0"
        ]
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "residence_type",
        "type": "nominal",
        "title": "Residence"
      },
      {
        "field": "pm25_ugm3",
        "type": "quantitative",
        "title": "PM2.5 (µg/m³)",
        "format": ".2f"
      }
    ]
  }
}