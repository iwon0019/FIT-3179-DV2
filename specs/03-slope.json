{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "03 slope",
  "width": "container",
  "height": 390,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "domain": false,
      "tickColor": "#e3e7e1",
      "gridColor": "#e3e7e1",
      "labelLimit": 130
    },
    "legend": {
      "labelColor": "#58675e",
      "titleColor": "#45564a",
      "titleFontSize": 11,
      "labelFontSize": 11,
      "orient": "bottom",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#287566",
        "#b86038",
        "#527da2",
        "#967544",
        "#796899",
        "#579189",
        "#9e5572",
        "#657940"
      ]
    },
    "title": {
      "color": "#203c30"
    }
  },
  "data": {
    "url": "data/site/annual.json"
  },
  "params": [
    {
      "name": "selectedCity",
      "value": "L00"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 60
        },
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "pm25",
          "type": "quantitative",
          "title": "Annual PM2.5 (µg/m³)",
          "scale": {
            "domain": [
              0,
              42
            ]
          }
        },
        "detail": {
          "field": "city"
        },
        "color": {
          "field": "city",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Kuala Lumpur",
              "George Town",
              "Ipoh",
              "Johor Bahru",
              "Kuantan",
              "Kuching",
              "Miri",
              "Kota Kinabalu"
            ],
            "range": [
              "#287566",
              "#b86038",
              "#527da2",
              "#967544",
              "#796899",
              "#579189",
              "#9e5572",
              "#657940"
            ]
          },
          "legend": {
            "title": "Location",
            "orient": "bottom",
            "columns": 2,
            "labelFontSize": 12,
            "labelLimit": 150,
            "symbolOpacity": 1,
            "rowPadding": 7
          }
        },
        "opacity": {
          "condition": {
            "test": "datum.location_key == selectedCity",
            "value": 1
          },
          "value": 0.35
        },
        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "Location"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "pm25",
            "type": "quantitative",
            "title": "PM2.5 (µg/m³)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.location_key == selectedCity"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "pm25",
          "type": "quantitative"
        },
        "text": {
          "field": "pm25",
          "type": "quantitative",
          "format": ".2f"
        },
        "color": {
          "field": "city",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Kuala Lumpur",
              "George Town",
              "Ipoh",
              "Johor Bahru",
              "Kuantan",
              "Kuching",
              "Miri",
              "Kota Kinabalu"
            ],
            "range": [
              "#287566",
              "#b86038",
              "#527da2",
              "#967544",
              "#796899",
              "#579189",
              "#9e5572",
              "#657940"
            ]
          },
          "legend": {
            "title": "Location",
            "orient": "bottom",
            "columns": 2,
            "labelFontSize": 12,
            "labelLimit": 150,
            "symbolOpacity": 1,
            "rowPadding": 7
          }
        }
      }
    }
  ]
}